{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniFlow Personal Assistance API (Single Endpoint)",
    "version": "1.0.3",
    "description": "Single-endpoint contract for both native UI and Custom GPT. Public contract is capability-level (personal assistance). Internal low-level tools are hidden behind tool_call_handler orchestration."
  },
  "servers": [
    {
      "url": "https://agentbackendservice-dfcpcudzeah4b6ae.northeurope-01.azurewebsites.net"
    }
  ],
  "components": {
    "securitySchemes": {
      "functionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-functions-key",
        "description": "Optional when endpoint runs anonymous; required when function auth is enabled. Configure in GPT Action Authentication, do not hardcode secrets in schema."
      }
    },
    "schemas": {
      "CapabilityName": {
        "type": "string",
        "enum": [
          "task.create",
          "task.list",
          "task.update",
          "task.complete",
          "task.delete",
          "task.delayed",
          "mail.status",
          "mail.authorize",
          "mail.inbox.list",
          "mail.read",
          "mail.summarize",
          "mail.reply",
          "mail.send",
          "mail.trash",
          "mail.delete",
          "mail.accounts.list",
          "calendar.events.list",
          "calendar.events.get",
          "calendar.events.create",
          "calendar.events.update",
          "calendar.events.delete",
          "planning.build_day_plan",
          "memory.interaction.save",
          "memory.interaction.list",
          "memory.preferences.get",
          "memory.preferences.update",
          "system.now",
          "memory.session.summary.get",
          "memory.session.events.list"
        ]
      },
      "CapabilityExecParams": {
        "type": "object",
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/CapabilityName"
          },
          "confirm": {
            "type": "boolean",
            "default": false,
            "description": "Required for destructive actions like task.delete/mail.trash/mail.delete."
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true,
            "description": "Capability-specific payload. For memory.interaction.save provide either (user_message + assistant_response) or (role + content). Optional per-call user override can be passed as arguments.user_id. For mail/calendar capabilities you can pass arguments.account_slot = primary|secondary."
          }
        },
        "required": [
          "capability"
        ],
        "additionalProperties": false
      },
      "ToolCallHandlerRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "capability_exec",
              "chat",
              "pa_init",
              "tool_exec"
            ],
            "description": "Use capability_exec for Custom GPT and chat for native UI. Custom GPT chat calls are blocked by policy."
          },
          "user_id": {
            "type": "string",
            "description": "User namespace identifier."
          },
          "thread_id": {
            "type": "string",
            "description": "Optional conversation/session identifier."
          },
          "params": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CapabilityExecParams"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Optional chat message for action=chat."
          }
        },
        "required": [
          "action",
          "user_id"
        ],
        "additionalProperties": true
      },
      "ToolCallHandlerResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "ok",
              "error"
            ]
          },
          "action": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "security": [
    {
      "functionKey": []
    }
  ],
  "paths": {
    "/api/tool_call_handler": {
      "post": {
        "operationId": "tool_call_handler_single_endpoint",
        "summary": "Single endpoint for Personal Assistance capabilities",
        "description": "Unified endpoint for both Custom GPT and native UI. Prefer action=capability_exec for Custom GPT. First call for a new user must be action=pa_init with params.confirm_create=true. For Gmail onboarding call capability=mail.authorize first, then call mailbox capabilities.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolCallHandlerRequest"
              },
              "examples": {
                "bootstrap_pa_init": {
                  "summary": "Initialize PA starter pack (required once per new user)",
                  "value": {
                    "action": "pa_init",
                    "user_id": "user_default",
                    "params": {
                      "confirm_create": true
                    }
                  }
                },
                "task_create": {
                  "summary": "Create task via capability",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "task.create",
                      "confirm": false,
                      "arguments": {
                        "title": "Prepare quarterly report",
                        "due_date": "2026-03-14",
                        "priority": "high"
                      }
                    }
                  }
                },
                "mail_send": {
                  "summary": "Send email via capability",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "mail.send",
                      "confirm": true,
                      "arguments": {
                        "to": [
                          "someone@example.com"
                        ],
                        "subject": "Status update",
                        "body": "Quick project update."
                      }
                    }
                  }
                },
                "mail_authorize": {
                  "summary": "Start or verify Gmail authorization",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "mail.authorize",
                      "confirm": false,
                      "arguments": {}
                    }
                  }
                },
                "mail_accounts_list": {
                  "summary": "List connected Gmail accounts (primary/secondary)",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "mail.accounts.list",
                      "arguments": {}
                    }
                  }
                },
                "calendar_events_list": {
                  "summary": "List upcoming primary calendar events",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "calendar.events.list",
                      "arguments": {
                        "account_slot": "primary",
                        "max_results": 10,
                        "time_min": "2026-03-11T00:00:00Z",
                        "time_max": "2026-03-18T00:00:00Z"
                      }
                    }
                  }
                },
                "calendar_events_create": {
                  "summary": "Create calendar event",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "calendar.events.create",
                      "confirm": true,
                      "arguments": {
                        "account_slot": "primary",
                        "summary": "Project sync",
                        "description": "Weekly team sync",
                        "start": {
                          "dateTime": "2026-03-12T09:00:00+01:00"
                        },
                        "end": {
                          "dateTime": "2026-03-12T09:30:00+01:00"
                        },
                        "location": "Teams"
                      }
                    }
                  }
                },
                "preferences_get": {
                  "summary": "Read long-term user preferences",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.preferences.get",
                      "arguments": {}
                    }
                  }
                },
                "preferences_update": {
                  "summary": "Update long-term user preferences",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.preferences.update",
                      "arguments": {
                        "preferences": {
                          "brevity": "short",
                          "fast_mode": true,
                          "disable_history_reads": true,
                          "allowed_reads": [
                            "TM.json",
                            "LO.json",
                            "semantics/preferences.json"
                          ]
                        }
                      }
                    }
                  }
                },
                "interaction_save_pair": {
                  "summary": "Save interaction with explicit pair fields",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.interaction.save",
                      "arguments": {
                        "thread_id": "thread-123",
                        "user_message": "Zrob plan dnia",
                        "assistant_response": "Pewnie, przygotowalem plan dnia.",
                        "metadata": {
                          "source": "custom_gpt"
                        }
                      }
                    }
                  }
                },
                "interaction_save_role_content": {
                  "summary": "Save interaction using role/content compatibility format",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.interaction.save",
                      "arguments": {
                        "thread_id": "thread-123",
                        "role": "user",
                        "content": "Przypomnij mi o spotkaniu jutro",
                        "metadata": {
                          "source": "custom_gpt"
                        }
                      }
                    }
                  }
                },
                "session_summary_get": {
                  "summary": "Get session summary for current day",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.session.summary.get",
                      "arguments": {}
                    }
                  }
                },
                "session_events_list": {
                  "summary": "List recent session events",
                  "value": {
                    "action": "capability_exec",
                    "user_id": "mario_test",
                    "params": {
                      "capability": "memory.session.events.list",
                      "arguments": {
                        "limit": 10,
                        "offset": 0
                      }
                    }
                  }
                },
                "ui_chat": {
                  "summary": "Native UI chat",
                  "value": {
                    "action": "chat",
                    "user_id": "mario_test",
                    "thread_id": "thread-123",
                    "message": "Show my delayed tasks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Handled request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCallHandlerResponse"
                },
                "examples": {
                  "mail_authorize_requires_consent": {
                    "summary": "mail.authorize response when interactive OAuth consent is required",
                    "value": {
