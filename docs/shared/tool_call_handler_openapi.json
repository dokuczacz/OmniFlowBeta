                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
                      "action": "capability_exec",
                      "capability": "memory.interaction.save",
                      "result": {
                        "status": "success",
                        "saved": true,
                        "interaction_id": "INT_20260310_200001_123456"
                      },
                      "error": null,
                      "meta": {}
                    }
                  },
                  "session_summary_success": {
                    "summary": "memory.session.summary.get success",
                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
                      "action": "capability_exec",
