                        "events_included": 12
                      },
                      "error": null,
                      "meta": {}
                    }
                  },
                  "session_events_list_success": {
                    "summary": "memory.session.events.list success",
                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
                      "action": "capability_exec",
                      "capability": "memory.session.events.list",
                      "result": {
                        "events": [
                          {
                            "schema_version": "omniflow.session_manifest.v1",
                            "event_id": "a1b2c3d4-...",
                            "session_id": "mario_test_20260311",
                            "user_id": "mario_test",
                            "timestamp_utc": "2026-03-11T14:22:00+00:00",
