                        "expires_at": "2026-03-10T17:13:42Z"
                      },
                      "error": null,
                      "meta": {}
                    }
                  },
                  "mail_accounts_list_success": {
                    "summary": "mail.accounts.list success",
                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
                      "action": "capability_exec",
                      "capability": "mail.accounts.list",
                      "result": {
                        "action": "gmail_accounts_list",
                        "user_id": "mario_test",
                        "accounts": [
                          {
                            "slot": "primary",
                            "email_address": "mario.primary@gmail.com",
                            "saved_at": "2026-03-11T09:00:00Z",
                            "expires_at": "2026-03-11T10:00:00Z",
                            "has_calendar_scope": true
                          },
                          {
                            "slot": "secondary",
                            "email_address": "mario.secondary@gmail.com",
                            "saved_at": "2026-03-11T09:10:00Z",
                            "expires_at": "2026-03-11T10:10:00Z",
                            "has_calendar_scope": true
                          }
                        ]
                      },
                      "error": null,
                      "meta": {}
                    }
                  },
                  "calendar_events_list_success": {
                    "summary": "calendar.events.list success",
                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
                      "action": "capability_exec",
                      "capability": "calendar.events.list",
                      "result": {
                        "action": "calendar_list_events",
                        "status": "ok",
                        "account_slot": "primary",
                        "events": [
                          {
                            "id": "evt_123",
                            "summary": "Project sync"
                          }
                        ],
                        "count": 1
                      },
                      "error": null,
