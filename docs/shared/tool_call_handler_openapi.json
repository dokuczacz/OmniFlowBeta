                        }
                      },
                      "error": null,
                      "meta": {}
                    }
                  },
                  "mail_inbox_list_enriched": {
                    "summary": "List inbox messages with triage-ready metadata",
                    "value": {
                      "schema_version": "omniflow.capability_exec.v1",
                      "status": "success",
