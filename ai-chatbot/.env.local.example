# Example local env for ai-chatbot/ (do not commit real secrets)

# Auth.js
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=

# If you are running without auth for local prototyping:
DISABLE_AUTH=1
NEXT_PUBLIC_DISABLE_AUTH=1

# OmniFlow backend entrypoint used by `ai-chatbot/app/api/omni/route.ts`
# Typically points directly to the Azure Functions tool handler endpoint.
OMNIFLOW_BACKEND_URL=http://localhost:7071/api/tool_call_handler

