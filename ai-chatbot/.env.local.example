# Example local env for ai-chatbot/ (do not commit real secrets)

# Auth.js
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=

# If you are running without auth for local prototyping:
DISABLE_AUTH=1
NEXT_PUBLIC_DISABLE_AUTH=1

# OmniFlow backend entrypoint used by `ai-chatbot/app/api/omni/route.ts`
# Typically points directly to the Azure Functions tool handler endpoint.
OMNIFLOW_BACKEND_URL=http://localhost:7071/api/tool_call_handler

# Optional: used by the MVP UI env switch (prod preset).
# Example:
# OMNIFLOW_BACKEND_URL_PROD=https://agentbackendservice-<...>.azurewebsites.net/api/tool_call_handler
OMNIFLOW_BACKEND_URL_PROD=

# Optional: if your Azure Function `custom_bridge` is protected (AuthLevel=Function),
# set its function key here so `/api/gmail` can call it in prod.
OMNIFLOW_CUSTOM_BRIDGE_FUNCTION_KEY=

# Optional: one host-level function key for the whole Azure Function App.
# If set, the Next.js API routes will attach it as `x-functions-key` for
# tool_call_handler, custom_bridge, and progress polling.
OMNIFLOW_AZFUNC_FUNCTION_KEY=

